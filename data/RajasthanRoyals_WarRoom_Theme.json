{
  "name": "Rajasthan Royals War Room Theme",
  "dataColors": [
    "#EA1A85",
    "#004B8C",
    "#F5A623",
    "#00D2FF",
    "#10B981",
    "#8B5CF6",
    "#EF4444",
    "#64748B"
  ],
  "background": "#0A1128",
  "foreground": "#FFFFFF",
  "tableAccent": "#EA1A85",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "transparency": 10
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "radius": 8
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#070D1E"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}